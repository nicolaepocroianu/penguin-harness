{
  "name": "@waterford/waf-harness-desktop",
  "version": "0.2.16",
  "private": true,
  "type": "module",
  "description": "WAF Harness desktop app: Electron shell running @waterford/waf-harness-server as a utilityProcess, window on http://localhost (same-origin HTTP/SSE, no private IPC).",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsup && node scripts/build-assets.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "start": "node scripts/preflight.mjs && electron .",
    "image": "node ../../scripts/deploy.mjs --out dist/install-image.gz --skip-web-build",
    "pack": "node scripts/preflight.mjs && pnpm run image && electron-builder",
    "pack:linux": "node scripts/preflight.mjs && pnpm run image && electron-builder --linux",
    "pack:mac": "node scripts/preflight.mjs && pnpm run image && electron-builder --mac",
    "pack:win": "node scripts/preflight.mjs && pnpm run image && electron-builder --win"
  },
  "dependencies": {
    "@waf-harness/a2ui": "workspace:*",
    "@waf-harness/ace-rsi-toolkit": "workspace:*",
    "@waf-harness/agent-company": "workspace:*",
    "@waf-harness/agent-development": "workspace:*",
    "@waf-harness/agent-evaluation": "workspace:*",
    "@waf-harness/ape-rsi-toolkit": "workspace:*",
    "@waf-harness/awm-rsi-toolkit": "workspace:*",
    "@waf-harness/browser-automation": "workspace:*",
    "@waf-harness/continual-learning": "workspace:*",
    "@waf-harness/data-analysis": "workspace:*",
    "@waf-harness/default-rsi-toolkit": "workspace:*",
    "@waf-harness/goal": "workspace:*",
    "@waf-harness/humanizer": "workspace:*",
    "@waf-harness/model-development": "workspace:*",
    "@waf-harness/opro-rsi-toolkit": "workspace:*",
    "@waf-harness/wafh-support": "workspace:*",
    "@waf-harness/skill-porting": "workspace:*",
    "@waf-harness/software-development": "workspace:*",
    "@waf-harness/use-bento-slides": "workspace:*",
    "@waf-harness/use-firecrawl": "workspace:*",
    "@waf-harness/use-claude-code": "workspace:*",
    "@waf-harness/use-codex": "workspace:*"
  },
  "devDependencies": {
    "@waterford/waf-harness-cli": "workspace:*",
    "@waterford/waf-harness-core": "workspace:*",
    "@waterford/waf-harness-server": "workspace:*",
    "@types/node": "^24.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.16.1",
    "electron-updater": "^6.8.9",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6",
    "yaml": "^2.5.0"
  }
}
