{
  "name": "@waterford/waf-harness-core",
  "version": "0.2.16",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "description": "WAF Harness core SDK: context_engine, OmniMessage protocol, LLM/Environment interfaces.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicolaepocroianu/waf-harness.git",
    "directory": "packages/core"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./omnimessage": {
      "types": "./dist/omnimessage/index.d.ts",
      "import": "./dist/omnimessage/index.js"
    },
    "./markers": {
      "types": "./dist/omnimessage/markers/index.d.ts",
      "import": "./dist/omnimessage/markers/index.js"
    },
    "./interfaces": {
      "types": "./dist/interfaces/index.d.ts",
      "import": "./dist/interfaces/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin/index.js"
    },
    "./context-limits": {
      "types": "./dist/llm/context-limits.d.ts",
      "import": "./dist/llm/context-limits.js"
    },
    "./release-identity": {
      "types": "./dist/release-identity.d.ts",
      "import": "./dist/release-identity.js"
    },
    "./model-connection": {
      "types": "./dist/state/model-connection.d.ts",
      "import": "./dist/state/model-connection.js"
    },
    "./a2ui": {
      "types": "./dist/a2ui/index.d.ts",
      "import": "./dist/a2ui/index.js"
    },
    "./kernel": {
      "types": "./dist/kernel/index.d.ts",
      "import": "./dist/kernel/index.js",
      "default": "./dist/kernel/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "node ../../scripts/run-with-env.mjs WAFH_E2E=1 -- vitest run test/llm.e2e.test.ts",
    "build": "tsup"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@waf-harness/a2ui": "workspace:*",
    "@waf-harness/ace-rsi-toolkit": "workspace:*",
    "@waf-harness/agent-company": "workspace:*",
    "@waf-harness/agent-development": "workspace:*",
    "@waf-harness/agent-evaluation": "workspace:*",
    "@waf-harness/ape-rsi-toolkit": "workspace:*",
    "@waf-harness/awm-rsi-toolkit": "workspace:*",
    "@waf-harness/browser-automation": "workspace:*",
    "@waf-harness/continual-learning": "workspace:*",
    "@waf-harness/data-analysis": "workspace:*",
    "@waf-harness/default-rsi-toolkit": "workspace:*",
    "@waf-harness/goal": "workspace:*",
    "@waf-harness/humanizer": "workspace:*",
    "@waf-harness/model-development": "workspace:*",
    "@waf-harness/opro-rsi-toolkit": "workspace:*",
    "@waf-harness/wafh-support": "workspace:*",
    "@waf-harness/skill-porting": "workspace:*",
    "@waf-harness/software-development": "workspace:*",
    "@waf-harness/use-bento-slides": "workspace:*",
    "@waf-harness/use-firecrawl": "workspace:*",
    "@waf-harness/use-claude-code": "workspace:*",
    "@waf-harness/use-codex": "workspace:*",
    "@waf-harness/waf-authoring": "workspace:*",
    "@prismshadow/agenthub": "0.4.15",
    "@prismshadow/mmsp": "^0.5.4",
    "arktype": "^2.2.3",
    "smol-toml": "^1.3.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "3.2.7",
    "dotenv": "^17.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6",
    "zod": "^4.2.0"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
