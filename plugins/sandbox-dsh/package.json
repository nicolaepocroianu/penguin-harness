{
  "name": "@waf-harness/sandbox-dsh",
  "version": "0.2.3",
  "type": "module",
  "description": "DeepSeek Harness sandbox adaptor for WAF Harness: the DSH local backend chain behind the harness's own sandbox interface.",
  "keywords": [
    "wafh-plugin",
    "waf-harness",
    "sandbox",
    "linux",
    "macos",
    "windows",
    "dsh",
    "filesystem-only"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicolaepocroianu/waf-harness.git",
    "directory": "plugins/sandbox-dsh"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "icon.svg",
    "ifaces.json",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "build": "node ../../scripts/gen-ifaces.mjs --project tsconfig.json --out ifaces.json && tsup"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-sandbox-local": "0.1.0-rc.7",
    "@deepseek-ai/node-addon-landlock-run": "^0.1.1",
    "koffi": "^3.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-sandbox": "0.1.0-rc.7",
    "@waterford/waf-harness-core": "workspace:*",
    "tsup": "^8.3.0",
    "vitest": "^3.2.6"
  },
  "wafh": {
    "short_description": "Linux, macOS and Windows: confine file writes only.",
    "category": "sandbox",
    "icon": "icon.svg",
    "preinstall": false,
    "title": "DSH Sandbox"
  }
}
