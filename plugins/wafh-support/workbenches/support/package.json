{
  "name": "wafh-support-workbench",
  "version": "1.0.0",
  "type": "module",
  "wafh": {
    "version": "2026.10.14.3",
    "modules": [
      {
        "name": "Workbench",
        "requires": {
          "host": {
            "iface": "@waterford/waf-harness-server#WorkbenchHost",
            "from": "Host"
          }
        },
        "provides": {
          "main": "@waterford/waf-harness-server#WorkbenchMain"
        },
        "contributes": {
          "WebModule.sessionTabs": [
            {
              "id": "support.main",
              "key": "support",
              "title": "Support",
              "titleZh": "客服工作台",
              "renderer": {
                "iframe": {
                  "src": "ui/index.html"
                }
              }
            }
          ]
        }
      }
    ]
  }
}
